<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_valuation_list" model="ir.ui.view">
        <field name="name">property.valuation.list</field>
        <field name="model">property.valuation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/><field name="property_id"/><field name="method"/>
                <field name="valuer_id"/><field name="market_value"/><field name="cap_rate"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_valuation" model="ir.actions.act_window">
        <field name="name">Property Valuations</field>
        <field name="res_model">property.valuation</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_valuation" name="Property Valuations"
              parent="rental_management.main_menu_rental_management"
              action="action_valuation" sequence="76"/>
</odoo>
