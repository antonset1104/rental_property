<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Home: add "Contracts" and "Maintenance" cards with live count -->
    <template id="portal_my_home_contract" inherit_id="portal.portal_my_home"
              name="Portal My Home: Contracts &amp; Maintenance">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Contracts</t>
                <t t-set="url" t-value="'/my/contracts'"/>
                <t t-set="text">Your lease contracts</t>
                <t t-set="placeholder_count" t-value="'contract_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Maintenance &amp; Complaints</t>
                <t t-set="url" t-value="'/my/maintenance'"/>
                <t t-set="text">Maintenance requests and complaints</t>
                <t t-set="placeholder_count" t-value="'maintenance_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Contracts list -->
    <template id="portal_my_contracts" name="My Contracts">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Contracts</t>
            </t>
            <t t-if="not contracts">
                <div class="alert alert-info" role="alert">
                    There are currently no contracts for your account.
                </div>
            </t>
            <t t-if="contracts" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Property</th>
                        <th>Start Date</th>
                        <th>Status</th>
                        <th class="text-end">Rent</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="contracts" t-as="contract">
                        <td>
                            <a t-attf-href="/my/contracts/#{contract.id}">
                                <t t-out="contract.tenancy_seq"/>
                            </a>
                        </td>
                        <td t-out="contract.portal_property_name"/>
                        <td><span t-field="contract.start_date"/></td>
                        <td><span t-field="contract.contract_type"/></td>
                        <td class="text-end"><span t-field="contract.total_rent"/></td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Contract detail -->
    <template id="portal_contract_page" name="Contract">
        <t t-call="portal.portal_layout">
            <div class="row">
                <div class="col-12">
                    <h4 class="mb-3">
                        Contract <span t-out="contract.tenancy_seq"/>
                    </h4>
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <strong>Property:</strong>
                                    <span t-out="contract.portal_property_name"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Tenant:</strong>
                                    <span t-field="contract.tenancy_id"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Status:</strong>
                                    <span t-field="contract.contract_type"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Payment Term:</strong>
                                    <span t-field="contract.payment_term"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Start Date:</strong>
                                    <span t-field="contract.start_date"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>End Date:</strong>
                                    <span t-field="contract.end_date"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Rent:</strong>
                                    <span t-field="contract.total_rent"/>
                                </div>
                            </div>
                            <t t-if="contract.inspection_ids">
                                <hr class="my-4"/>
                                <h5 class="mb-3 text-success"><i class="fa fa-clipboard"/> Dokumen Berita Acara Serah Terima (BAST) &amp; Inspeksi</h5>
                                <table class="table table-bordered table-sm mb-3">
                                    <thead class="table-light">
                                        <tr>
                                            <th>No. BAST</th>
                                            <th>Jenis Serah Terima</th>
                                            <th>Tanggal</th>
                                            <th>Stand Listrik</th>
                                            <th>Stand Air</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="contract.inspection_ids" t-as="insp">
                                            <td><strong t-out="insp.name"/></td>
                                            <td><span t-field="insp.inspection_type"/></td>
                                            <td><span t-field="insp.date"/></td>
                                            <td><t t-out="insp.meter_electricity"/> kWh</td>
                                            <td><t t-out="insp.meter_water"/> m³</td>
                                            <td>
                                                <span t-if="insp.state == 'confirmed'" class="badge bg-success">Disahkan</span>
                                                <span t-else="" class="badge bg-warning">Draft</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <div class="mt-3">
                                <a href="/my/invoices" class="btn btn-primary">
                                    <i class="fa fa-file-text-o"/> View My Invoices
                                </a>
                                <a href="/my/maintenance/new" class="btn btn-warning ms-2">
                                    <i class="fa fa-wrench"/> Request Maintenance / Complaint
                                </a>
                                <a href="/my/contracts" class="btn btn-link">
                                    Back to Contracts
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Maintenance List -->
    <template id="portal_my_maintenance_requests" name="My Maintenance Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Maintenance &amp; Complaints</t>
            </t>
            <div class="row mb-3">
                <div class="col-12 text-end">
                    <a href="/my/maintenance/new" class="btn btn-primary">
                        <i class="fa fa-plus"/> Submit New Request / Complaint
                    </a>
                </div>
            </div>
            <t t-if="not requests">
                <div class="alert alert-info" role="alert">
                    Belum ada permohonan maintenance atau komplain yang diajukan.
                </div>
            </t>
            <t t-if="requests" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Subject</th>
                        <th>Property / Unit</th>
                        <th>Contract</th>
                        <th>Date</th>
                        <th>Stage / Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="requests" t-as="req">
                        <td>
                            <a t-attf-href="/my/maintenance/#{req.id}">
                                <t t-out="req.name"/>
                            </a>
                        </td>
                        <td><span t-field="req.property_id.name"/></td>
                        <td><span t-field="req.tenancy_id.tenancy_seq"/></td>
                        <td><span t-field="req.request_date"/></td>
                        <td>
                            <span class="badge rounded-pill bg-info" t-field="req.stage_id.name"/>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Maintenance New Form -->
    <template id="portal_maintenance_new" name="New Maintenance Request">
        <t t-call="portal.portal_layout">
            <div class="row">
                <div class="col-12 col-md-8 offset-md-2">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Ajukan Permintaan Maintenance / Komplain</h5>
                        </div>
                        <div class="card-body">
                            <form action="/my/maintenance/new" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-3">
                                    <label class="form-label" for="tenancy_id">Kontrak / Unit Terkait <span class="text-danger">*</span></label>
                                    <select name="tenancy_id" id="tenancy_id" class="form-select" required="required">
                                        <option value="">-- Pilih Kontrak / Unit --</option>
                                        <t t-foreach="contracts" t-as="c">
                                            <option t-att-value="c.id">
                                                <t t-out="c.tenancy_seq"/> - <t t-out="c.property_id.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="name">Judul / Pokok Permasalahan <span class="text-danger">*</span></label>
                                    <input type="text" name="name" id="name" class="form-control" required="required" placeholder="Contoh: AC Unit Bocor / Lampu Koridor Mati"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="priority">Tingkat Urgensi</label>
                                    <select name="priority" id="priority" class="form-select">
                                        <option value="1">Biasa (Normal)</option>
                                        <option value="2">Mendesak (Urgent)</option>
                                        <option value="3">Sangat Mendesak (Emergency)</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="description">Rincian Keluhan / Permintaan <span class="text-danger">*</span></label>
                                    <textarea name="description" id="description" class="form-control" rows="4" required="required" placeholder="Jelaskan secara rinci lokasi dan kendala yang dialami..."></textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="attachment">Lampirkan Foto / Dokumen Pendukung (Opsional)</label>
                                    <input type="file" name="attachment" id="attachment" class="form-control" accept="image/*,.pdf"/>
                                </div>
                                <div class="mt-4 text-end">
                                    <a href="/my/maintenance" class="btn btn-secondary me-2">Batal</a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-paper-plane"/> Kirim Permintaan
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Maintenance Page Detail -->
    <template id="portal_maintenance_page" name="Maintenance Detail">
        <t t-call="portal.portal_layout">
            <div class="row">
                <div class="col-12">
                    <h4 class="mb-3">
                        <span t-out="req.name"/>
                    </h4>
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <strong>Property / Unit:</strong>
                                    <span t-out="req.property_id.name if req.property_id else '-'"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Kontrak Sewa:</strong>
                                    <span t-out="req.tenancy_id.tenancy_seq if req.tenancy_id else '-'"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Tanggal Pengajuan:</strong>
                                    <span t-field="req.request_date"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Status / Progres:</strong>
                                    <span class="badge bg-primary" t-field="req.stage_id.name"/>
                                </div>
                                <div class="col-12 mt-3">
                                    <strong>Rincian Keluhan:</strong>
                                    <div class="p-3 bg-light rounded mt-1">
                                        <span t-field="req.description"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Rating Kepuasan CSAT -->
                            <div class="mt-4 pt-3 border-top">
                                <t t-if="req.portal_rating">
                                    <div class="alert alert-success d-flex align-items-center mb-0">
                                        <i class="fa fa-star fa-2x me-3 text-warning"/>
                                        <div>
                                            <strong>Terima kasih atas penilaian Anda!</strong><br/>
                                            Rating Diberikan: <b><span t-field="req.portal_rating"/></b><br/>
                                            <t t-if="req.portal_feedback">
                                                Masukan: <em>"<span t-field="req.feedback"/>"</em>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <h6 class="fw-bold mb-2">⭐ Berikan Penilaian Kinerja Teknisi / Tim Maintenance</h6>
                                            <p class="text-muted small mb-3">Bantu kami meningkatkan kualitas pelayanan dengan memberikan penilaian atas penanganan tiket ini.</p>
                                            <form t-attf-action="/my/maintenance/#{req.id}/rate" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Tingkat Kepuasan:</label>
                                                    <select name="rating" class="form-select" style="max-width: 300px;" required="required">
                                                        <option value="5">⭐⭐⭐⭐⭐ 5 - Sangat Puas</option>
                                                        <option value="4">⭐⭐⭐⭐ 4 - Baik</option>
                                                        <option value="3">⭐⭐⭐ 3 - Cukup</option>
                                                        <option value="2">⭐⭐ 2 - Buruk</option>
                                                        <option value="1">⭐ 1 - Sangat Buruk</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Ulasan / Masukan Tambahan (Opsional):</label>
                                                    <textarea name="feedback" class="form-control" rows="2" placeholder="Bagikan pengalaman Anda mengenai kecepatan dan keramahan tim teknisi..."></textarea>
                                                </div>
                                                <button type="submit" class="btn btn-warning">
                                                    <i class="fa fa-paper-plane"/> Kirim Penilaian
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <div class="mt-4">
                                <a href="/my/maintenance" class="btn btn-secondary">
                                    <i class="fa fa-arrow-left"/> Kembali ke Daftar Maintenance
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Upload Bukti Pembayaran pada Halaman Invoice Portal -->
    <template id="portal_invoice_payment_proof" inherit_id="account.portal_invoice_page"
              name="Portal Invoice: Upload Payment Proof">
        <xpath expr="//div[hasclass('o_portal_html_view')]" position="before">
            <t t-if="invoice.payment_state in ('not_paid', 'partial')">
                <div class="card mb-4 border-info shadow-sm">
                    <div class="card-header bg-info text-white d-flex align-items-center">
                        <i class="fa fa-credit-card me-2"/>
                        <h6 class="mb-0 fw-bold">Konfirmasi / Upload Bukti Transfer Pembayaran</h6>
                    </div>
                    <div class="card-body">
                        <t t-if="invoice.portal_payment_proof_status == 'submitted'">
                            <div class="alert alert-success d-flex align-items-center" role="alert">
                                <i class="fa fa-check-circle fa-2x me-3"/>
                                <div>
                                    <strong>Bukti transfer Anda telah berhasil diunggah!</strong><br/>
                                    File: <span t-out="invoice.portal_payment_proof_filename"/><br/>
                                    Status: <em>Sedang dalam proses verifikasi oleh Tim Keuangan.</em>
                                </div>
                            </div>
                        </t>
                        <form t-attf-action="/my/invoices/#{invoice.id}/upload_proof" method="post"
                              enctype="multipart/form-data" class="row g-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="col-md-6">
                                <label for="proof_file" class="form-label fw-bold">File Bukti Transfer (PDF / Foto Struk) <span class="text-danger">*</span></label>
                                <input type="file" name="proof_file" id="proof_file" class="form-control" accept="image/*,application/pdf" required="1"/>
                            </div>
                            <div class="col-md-6">
                                <label for="payment_date" class="form-label fw-bold">Tanggal Pembayaran</label>
                                <input type="date" name="payment_date" id="payment_date" class="form-control"/>
                            </div>
                            <div class="col-12">
                                <label for="payment_notes" class="form-label">Catatan Pembayaran / No. Referensi Transfer</label>
                                <input type="text" name="payment_notes" id="payment_notes" class="form-control" placeholder="Contoh: Transfer via BCA a.n PT ABC / Ref: 98127398"/>
                            </div>
                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-upload me-1"/> Kirim Bukti Pembayaran
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
