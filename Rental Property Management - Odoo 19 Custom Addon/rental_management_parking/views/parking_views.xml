<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_parking_pass_form" model="ir.ui.view">
        <field name="name">property.parking.pass.form</field>
        <field name="model">property.parking.pass</field>
        <field name="arch" type="xml">
            <form string="Kartu Pass Parkir Tenant">
                <header>
                    <button name="action_activate" type="object" string="✅ Aktifkan Pass Parkir" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_expire" type="object" string="Set Kedaluwarsa" class="btn-warning"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Batalkan" class="btn-secondary"
                            invisible="state in ('expired', 'cancelled')"/>
                    <button name="%(action_report_parking_pass)d" type="action"
                            string="🖨️ Cetak Formulir Parkir (PDF)" class="btn-outline-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Pass Parkir"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Data Kendaraan &amp; Pengemudi">
                            <field name="vehicle_type"/>
                            <field name="plate_number"/>
                            <field name="vehicle_brand"/>
                            <field name="driver_name"/>
                            <field name="driver_phone"/>
                            <field name="rfid_card_number"/>
                        </group>
                        <group string="Kontrak Sewa &amp; Tarif">
                            <field name="tenancy_id"/>
                            <field name="tenant_id"/>
                            <field name="property_id"/>
                            <field name="parking_quota_type"/>
                            <field name="monthly_fee" invisible="parking_quota_type == 'free'"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Catatan Tambahan" name="notes">
                            <field name="notes" placeholder="Catatan nomor stiker, nomor slot khusus VIP, dll..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_property_parking_pass_list" model="ir.ui.view">
        <field name="name">property.parking.pass.list</field>
        <field name="model">property.parking.pass</field>
        <field name="arch" type="xml">
            <list string="Kartu Pass Parkir Tenant">
                <field name="name"/>
                <field name="plate_number"/>
                <field name="vehicle_type"/>
                <field name="driver_name"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="rfid_card_number"/>
                <field name="parking_quota_type"/>
                <field name="monthly_fee" optional="show"/>
                <field name="date_end"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expired'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="action_property_parking_pass" model="ir.actions.act_window">
        <field name="name">Pass Parkir Tenant</field>
        <field name="res_model">property.parking.pass</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_property_parking_pass"
              name="Langganan Parkir Tenant"
              parent="rental_management.menu_property"
              action="action_property_parking_pass"
              sequence="29"/>
</odoo>
