<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_coretax" model="ir.ui.view">
        <field name="name">account.move.form.coretax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pajak CORETAX &amp; PPh 4(2)" name="coretax_faktur">
                    <group>
                        <group string="Faktur Pajak Keluaran (CORETAX)">
                            <field name="coretax_faktur_number" placeholder="040.001-26.00000100"/>
                            <field name="coretax_faktur_date"/>
                            <field name="coretax_trx_code"/>
                            <field name="coretax_invoice_opt"/>
                            <field name="coretax_exported" readonly="1"/>
                            <field name="coretax_export_date" readonly="1"/>
                        </group>
                        <group string="PPh Final Pasal 4 Ayat (2) - 10%">
                            <field name="is_pph42_applicable"/>
                            <field name="pph42_amount" readonly="1"/>
                            <field name="pph42_ebupot_status"/>
                            <field name="pph42_ebupot_number" invisible="pph42_ebupot_status == 'none'"/>
                            <field name="pph42_ebupot_date" invisible="pph42_ebupot_status == 'none'"/>
                            <field name="pph42_ebupot_attachment" filename="pph42_ebupot_number" invisible="pph42_ebupot_status == 'none'"/>
                        </group>
                    </group>
                    <group string="Sewa Valas Multi-Currency &amp; Kurs KMK">
                        <group>
                            <field name="is_foreign_currency_lease"/>
                            <field name="lease_foreign_currency_id" invisible="not is_foreign_currency_lease"/>
                            <field name="lease_foreign_amount" invisible="not is_foreign_currency_lease"/>
                        </group>
                        <group>
                            <field name="exchange_rate_date" invisible="not is_foreign_currency_lease"/>
                            <field name="tax_exchange_rate_kmk" invisible="not is_foreign_currency_lease"/>
                            <field name="bi_transaction_rate" invisible="not is_foreign_currency_lease"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
