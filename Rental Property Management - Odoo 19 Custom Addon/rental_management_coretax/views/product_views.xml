<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_coretax" model="ir.ui.view">
        <field name="name">product.template.form.coretax</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CORETAX" name="coretax">
                    <group>
                        <field name="coretax_opt"/>
                        <field name="coretax_code"/>
                        <field name="coretax_unit_code"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
