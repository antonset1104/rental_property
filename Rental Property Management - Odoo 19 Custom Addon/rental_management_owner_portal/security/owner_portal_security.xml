<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="property_details_owner_rule" model="ir.rule">
            <field name="name">Owner Portal: own properties</field>
            <field name="model_id" ref="rental_management.model_property_details"/>
            <field name="domain_force">[('owner_line_ids.owner_id','child_of',user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="owner_remittance_owner_rule" model="ir.rule">
            <field name="name">Owner Portal: own remittances</field>
            <field name="model_id" ref="rental_management_financial_report.model_property_owner_remittance"/>
            <field name="domain_force">[('line_ids.owner_id','child_of',user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
        </record>
        <record id="owner_remittance_line_owner_rule" model="ir.rule">
            <field name="name">Owner Portal: own remittance lines</field>
            <field name="model_id" ref="rental_management_financial_report.model_property_owner_remittance_line"/>
            <field name="domain_force">[('owner_id','child_of',user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
        </record>
    </data>
</odoo>
