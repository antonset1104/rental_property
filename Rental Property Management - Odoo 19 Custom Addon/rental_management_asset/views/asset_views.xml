<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_asset_list" model="ir.ui.view">
        <field name="name">property.asset.list</field>
        <field name="model">property.asset</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'closed'"
                  decoration-success="state == 'running'">
                <field name="name"/>
                <field name="property_id"/>
                <field name="acquisition_date"/>
                <field name="acquisition_value"/>
                <field name="gross_value"/>
                <field name="depreciated_total"/>
                <field name="book_value"/>
                <field name="method"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'running'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_property_asset_form" model="ir.ui.view">
        <field name="name">property.asset.form</field>
        <field name="model">property.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_board" type="object"
                            string="Compute Depreciation" invisible="state == 'closed'"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_post_depreciation" type="object"
                            string="Post Due Depreciation" class="btn-primary"
                            invisible="state != 'running'"/>
                    <button name="action_post_revaluations" type="object"
                            string="Post Revaluations" invisible="state == 'closed'"/>
                    <button name="action_sync_coretax_l9" type="object"
                            string="Sync CORETAX L9"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'running'"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Asset">
                            <field name="property_id"/>
                            <field name="partner_id"/>
                            <field name="acquisition_date"/>
                            <field name="acquisition_value"/>
                            <field name="salvage_value"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Depreciation Method">
                            <field name="method"/>
                            <field name="method_number"/>
                            <field name="method_period"/>
                            <field name="declining_factor"
                                   invisible="method != 'declining'"/>
                        </group>
                        <group string="Values">
                            <field name="gross_value"/>
                            <field name="depreciated_total"/>
                            <field name="revaluation_total"/>
                            <field name="book_value"/>
                        </group>
                        <group string="Accounts">
                            <field name="account_asset_id"/>
                            <field name="account_depreciation_id"/>
                            <field name="account_expense_id"/>
                            <field name="account_revaluation_id"/>
                            <field name="journal_id"/>
                        </group>
                        <group string="CORETAX L9">
                            <field name="asset_code"/>
                            <field name="asset_group"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Depreciation Board" name="board">
                            <field name="depreciation_line_ids">
                                <list>
                                    <field name="sequence"/>
                                    <field name="date"/>
                                    <field name="depreciation_amount"/>
                                    <field name="accumulated_value"/>
                                    <field name="remaining_value"/>
                                    <field name="move_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'posted'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Revaluations" name="revaluations">
                            <field name="revaluation_line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="reason"/>
                                    <field name="move_id" readonly="1"/>
                                    <field name="posted" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_property_asset" model="ir.actions.act_window">
        <field name="name">Fixed Assets</field>
        <field name="res_model">property.asset</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
