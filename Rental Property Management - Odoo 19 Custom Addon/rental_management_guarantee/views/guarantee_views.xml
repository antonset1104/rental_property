<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_tenant_guarantee_list" model="ir.ui.view">
        <field name="name">property.tenant.guarantee.list</field>
        <field name="model">property.tenant.guarantee</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'"
                  decoration-warning="is_expiring"
                  decoration-muted="state in ('released', 'claimed')">
                <field name="name"/>
                <field name="guarantee_type"/>
                <field name="tenancy_id"/>
                <field name="tenant_id"/>
                <field name="issuer"/>
                <field name="amount"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="is_expiring" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_property_tenant_guarantee_form" model="ir.ui.view">
        <field name="name">property.tenant.guarantee.form</field>
        <field name="model">property.tenant.guarantee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_release" type="object" string="Release"
                            invisible="state not in ('active', 'expired')"/>
                    <button name="action_claim" type="object" string="Claim"
                            invisible="state not in ('active', 'expired')"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="guarantee_type"/>
                            <field name="tenancy_id"/>
                            <field name="tenant_id"/>
                            <field name="property_id"/>
                            <field name="reference"/>
                            <field name="issuer"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="reminder_days"/>
                            <field name="days_to_expiry"/>
                            <field name="responsible_id"/>
                            <field name="is_expiring" invisible="1"/>
                            <field name="reminder_done" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Coverage notes / conditions..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_property_tenant_guarantee_search" model="ir.ui.view">
        <field name="name">property.tenant.guarantee.search</field>
        <field name="model">property.tenant.guarantee</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tenancy_id"/>
                <field name="tenant_id"/>
                <field name="issuer"/>
                <filter name="active_state" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="expiring" string="Expiring Soon" domain="[('is_expiring', '=', True)]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator string="Group By"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'guarantee_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_property" string="Property" context="{'group_by': 'property_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_property_tenant_guarantee" model="ir.actions.act_window">
        <field name="name">Tenant Guarantees</field>
        <field name="res_model">property.tenant.guarantee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_property_tenant_guarantee_search"/>
    </record>
</odoo>
