<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tenancy_details_form_view_guarantee" model="ir.ui.view">
        <field name="name">tenancy.details.form.guarantee</field>
        <field name="model">tenancy.details</field>
        <field name="inherit_id" ref="rental_management.tenancy_details_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Guarantees" name="guarantees">
                    <field name="guarantee_ids" context="{'default_tenancy_id': id}">
                        <list decoration-danger="state == 'expired'"
                              decoration-warning="is_expiring"
                              decoration-muted="state in ('released', 'claimed')">
                            <field name="name"/>
                            <field name="guarantee_type"/>
                            <field name="issuer"/>
                            <field name="reference"/>
                            <field name="amount"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry"/>
                            <field name="is_expiring" column_invisible="1"/>
                            <field name="state"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
