<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_details_form_view_financial" model="ir.ui.view">
        <field name="name">property.details.form.financial</field>
        <field name="model">property.details</field>
        <field name="inherit_id" ref="rental_management.property_details_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Owners &amp; Financial" name="owners_financial">
                    <group>
                        <group string="Property Management">
                            <field name="property_manager_id"/>
                            <field name="manager_phone"/>
                            <field name="manager_fax"/>
                        </group>
                        <group string="Spesifikasi Teknis Unit (MEP)">
                            <label for="master_unit_code"/>
                            <div class="o_row">
                                <field name="master_unit_code" placeholder="PMKBN001-GF-01"/>
                                <button name="action_generate_master_unit_code" type="object"
                                        string="Format ID" class="btn btn-outline-primary btn-sm"/>
                            </div>
                            <field name="unit_number"/>
                            <field name="electricity_power_va"/>
                            <field name="water_supply"/>
                            <field name="telephone_lines"/>
                            <field name="ac_unit_count"/>
                            <field name="has_sprinkler"/>
                            <field name="has_smoke_detector"/>
                            <field name="has_evac_speaker"/>
                            <field name="sewage_system"/>
                        </group>
                        <group string="Accounting">
                            <field name="analytic_account_id"/>
                            <field name="analytic_division_id"/>
                            <field name="analytic_subdivision_id"/>
                            <field name="analytic_dept_id"/>
                            <field name="analytic_location_id"/>
                            <button name="action_create_analytic_account" type="object"
                                    string="Create All Analytic Accounts" class="btn-link"
                                    invisible="analytic_account_id"/>
                            <button name="action_view_analytic_items" type="object"
                                    string="Analytic Items" class="btn-link"
                                    invisible="not analytic_account_id"/>
                        </group>
                        <group string="Trust Accounting" colspan="2">
                            <field name="trust_account_id"/>
                            <field name="remittance_account_id"/>
                            <field name="remittance_journal_id"/>
                        </group>
                        <group string="Security Deposit" colspan="2">
                            <field name="deposit_liability_account_id"/>
                            <field name="deposit_income_account_id"/>
                            <field name="deposit_journal_id"/>
                        </group>
                    </group>
                    <separator string="Owners"/>
                    <field name="owner_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="owner_id"/>
                            <field name="ownership_percentage"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="owner_city"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Tenancy Form View: Smart Button BAST & Inspeksi & Clearance Certificate -->
    <record id="tenancy_details_form_view_inspection" model="ir.ui.view">
        <field name="name">tenancy.details.form.inspection</field>
        <field name="model">tenancy.details</field>
        <field name="inherit_id" ref="rental_management.tenancy_details_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_report_clearance_certificate)d" type="action"
                        string="🖨️ Cetak Clearance Certificate" class="btn-secondary"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_inspections" type="object"
                        class="oe_stat_button" icon="fa-clipboard">
                    <field name="inspection_count" widget="statinfo" string="BAST &amp; Inspeksi"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
