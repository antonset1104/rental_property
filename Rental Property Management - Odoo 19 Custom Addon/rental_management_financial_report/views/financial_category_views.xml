<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_financial_category_list" model="ir.ui.view">
        <field name="name">property.financial.category.list</field>
        <field name="model">property.financial.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="section"/>
                <field name="group_name"/>
                <field name="account_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_property_financial_category_form" model="ir.ui.view">
        <field name="name">property.financial.category.form</field>
        <field name="model">property.financial.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="section"/>
                        </group>
                        <group>
                            <field name="group_name"/>
                            <field name="sequence"/>
                            <field name="analytic_account_id"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Mapped GL Accounts"/>
                    <field name="account_ids">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="account_type"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_financial_category" model="ir.actions.act_window">
        <field name="name">Report Categories</field>
        <field name="res_model">property.financial.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
