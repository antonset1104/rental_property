<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Accrual Template list -->
    <record id="view_accrual_template_list" model="ir.ui.view">
        <field name="name">property.accrual.template.list</field>
        <field name="model">property.accrual.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="months"/>
                <field name="account_id"/>
                <field name="expense_account_id"/>
                <field name="journal_id"/>
                <field name="category_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Accrual Template form -->
    <record id="view_accrual_template_form" model="ir.ui.view">
        <field name="name">property.accrual.template.form</field>
        <field name="model">property.accrual.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="months"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="account_id"/>
                            <field name="expense_account_id"/>
                            <field name="journal_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_accrual_template" model="ir.actions.act_window">
        <field name="name">Accrual Templates</field>
        <field name="res_model">property.accrual.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Inject accrual fields into vendor bill line (optional columns) -->
    <record id="view_move_form_accrual" model="ir.ui.view">
        <field name="name">account.move.form.accrual</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="accrual_template_id" optional="hide"
                       string="Accrual Template"
                       domain="[('company_id', 'in', [False, parent.company_id])]" />
                <field name="accrual_start_date" optional="hide"
                       string="Accrual Start"/>
            </xpath>
        </field>
    </record>
</odoo>
