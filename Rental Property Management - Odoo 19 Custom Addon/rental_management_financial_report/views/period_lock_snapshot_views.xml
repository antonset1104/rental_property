<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Period Lock ===== -->
    <record id="view_period_lock_list" model="ir.ui.view">
        <field name="name">property.period.lock.list</field>
        <field name="model">property.period.lock</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="reason"/>
                <field name="locked_by"/>
                <field name="locked_on"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_period_lock_form" model="ir.ui.view">
        <field name="name">property.period.lock.form</field>
        <field name="model">property.period.lock</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_unlock" type="object" string="Unlock Period"
                            class="btn-danger"
                            invisible="not active"
                            confirm="Unlock this period? Report figures may change."/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="reason"/>
                            <field name="locked_by" readonly="1"/>
                            <field name="locked_on" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_period_lock" model="ir.actions.act_window">
        <field name="name">Period Locks</field>
        <field name="res_model">property.period.lock</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== Report Snapshot ===== -->
    <record id="view_report_snapshot_list" model="ir.ui.view">
        <field name="name">property.report.snapshot.list</field>
        <field name="model">property.report.snapshot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="date_generated"/>
                <field name="generated_by"/>
            </list>
        </field>
    </record>

    <record id="view_report_snapshot_form" model="ir.ui.view">
        <field name="name">property.report.snapshot.form</field>
        <field name="model">property.report.snapshot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="property_id" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_generated" readonly="1"/>
                            <field name="generated_by" readonly="1"/>
                        </group>
                    </group>
                    <field name="summary_html" readonly="1" widget="html"
                           string="Detail Snapshot"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_report_snapshot" model="ir.actions.act_window">
        <field name="name">Report Snapshots</field>
        <field name="res_model">property.report.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
