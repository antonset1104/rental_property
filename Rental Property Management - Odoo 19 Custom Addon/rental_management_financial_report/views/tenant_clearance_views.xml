<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_tenant_clearance_form" model="ir.ui.view">
        <field name="name">property.tenant.clearance.form</field>
        <field name="model">property.tenant.clearance</field>
        <field name="arch" type="xml">
            <form string="Surat Bebas Kewajiban (Tenant Move-Out Clearance)">
                <header>
                    <button name="action_approve_all" type="object" string="✅ Setujui Seluruh Divisi (Clear)" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_refunded" type="object" string="💰 Tandai Deposit Dicairkan" class="btn-success"
                            invisible="state != 'approved'"/>
                    <button name="%(action_report_tenant_clearance_cert)d" type="action"
                            string="🖨️ Cetak Surat Clearance (PDF)" class="btn-outline-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,refunded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Clearance"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Kontrak Sewa &amp; Tanggal">
                            <field name="tenancy_id"/>
                            <field name="tenant_id"/>
                            <field name="property_id"/>
                            <field name="move_out_date"/>
                        </group>
                        <group string="Penyelesaian Deposit Jaminan">
                            <field name="deposit_held"/>
                            <field name="repair_deduction"/>
                            <field name="utility_deduction"/>
                            <field name="deposit_refund_amount" readonly="1" style="font-weight: bold; color: #28A745; font-size: 14px;"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Pemeriksaan Multi-Divisi Gedung (Sign-Off Checklist)">
                        <group>
                            <field name="finance_status" widget="radio"/>
                            <field name="engineering_status" widget="radio"/>
                        </group>
                        <group>
                            <field name="housekeeping_status" widget="radio"/>
                            <field name="security_status" widget="radio"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_property_tenant_clearance_list" model="ir.ui.view">
        <field name="name">property.tenant.clearance.list</field>
        <field name="model">property.tenant.clearance</field>
        <field name="arch" type="xml">
            <list string="Surat Bebas Kewajiban (Clearance)">
                <field name="name"/>
                <field name="tenancy_id"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="move_out_date"/>
                <field name="deposit_held"/>
                <field name="deposit_refund_amount"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'approved'"
                       decoration-success="state == 'refunded'"/>
            </list>
        </field>
    </record>

    <record id="action_property_tenant_clearance" model="ir.actions.act_window">
        <field name="name">Pengakhiran Sewa &amp; Clearance</field>
        <field name="res_model">property.tenant.clearance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_property_tenant_clearance"
              name="Surat Bebas Kewajiban (Clearance)"
              parent="rental_management.menu_tenancy_details"
              action="action_property_tenant_clearance"
              sequence="30"/>
</odoo>
