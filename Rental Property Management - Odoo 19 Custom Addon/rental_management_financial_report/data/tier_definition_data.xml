<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <data>
        <record id="property_budget_tier_definition" model="tier.definition">
            <field name="name">Property Budget - Approval</field>
            <field name="model_id" search="[('model', '=', 'property.budget')]"/>
            <field name="review_type">group</field>
            <field name="reviewer_group_id" ref="account.group_account_manager"/>
            <field name="definition_type">domain</field>
            <field name="definition_domain">[('state', '=', 'to_approve')]</field>
            <field name="active" eval="True"/>
            <field name="sequence" eval="10"/>
            <field name="approve_sequence" eval="False"/>
        </record>
    </data>
</odoo>
