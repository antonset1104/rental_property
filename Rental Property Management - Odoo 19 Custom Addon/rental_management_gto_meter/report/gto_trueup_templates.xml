<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_gto_trueup" model="ir.actions.report">
        <field name="name">Berita Acara Rekonsiliasi Omzet Tahunan</field>
        <field name="model">property.gto.trueup.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rental_management_gto_meter.report_gto_trueup_document</field>
        <field name="report_file">rental_management_gto_meter.report_gto_trueup_document</field>
        <field name="print_report_name">'BA_TrueUp_Omzet_%s' % object.fiscal_year</field>
    </record>

    <template id="report_gto_trueup_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 13px; color: #2C3E50;">
                        <div class="text-center" style="border-bottom: 2px solid #1F3964; padding-bottom: 8px; margin-bottom: 16px;">
                            <h2 style="color: #1F3964; font-weight: bold; margin: 0; text-transform: uppercase;">
                                BERITA ACARA REKONSILIASI OMZET TAHUNAN (TRUE-UP SETTLEMENT)
                            </h2>
                            <p style="margin: 4px 0 0 0; font-size: 13px; color: #555;">
                                <b>Tahun Fiskal:</b> <span t-field="doc.fiscal_year"/> | <b>Unit / Mall:</b> <span t-field="doc.property_id.name"/>
                            </p>
                        </div>
                        <table class="table table-bordered table-sm" style="margin-bottom: 16px; border-color: #B0C4DE;">
                            <tbody>
                                <tr style="background-color: #F4F7FB;">
                                    <td colspan="2" style="font-weight: bold; color: #1F3964;">DATA TENANT &amp; KONTRAK SEWA</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; width: 30%;">Nama Tenant / Toko:</td>
                                    <td style="width: 70%;"><span t-field="doc.tenant_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Nomor Kontrak:</td>
                                    <td><span t-field="doc.tenancy_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Pengelola Gedung:</td>
                                    <td><span t-field="doc.company_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h5 style="color: #1F3964; font-weight: bold;">HASIL REKONSILIASI PERHITUNGAN:</h5>
                        <table class="table table-bordered table-sm" style="margin-bottom: 16px; border-color: #B0C4DE;">
                            <tbody>
                                <tr>
                                    <td style="width: 60%;">1. Realisasi Omzet Penjualan (Laporan Audit Tenant):</td>
                                    <td style="text-align: right; width: 40%;">Rp <span t-field="doc.annual_audited_turnover" t-options="{'widget': 'monetary', 'display_currency': doc.tenancy_id.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td>2. Persentase Bagi Hasil Omzet (%):</td>
                                    <td style="text-align: right;"><span t-field="doc.turnover_percentage"/> %</td>
                                </tr>
                                <tr style="background-color: #F4F7FB; font-weight: bold;">
                                    <td>3. Total Kewajiban Bagi Hasil Omzet:</td>
                                    <td style="text-align: right;">Rp <span t-field="doc.calculated_turnover_rent" t-options="{'widget': 'monetary', 'display_currency': doc.tenancy_id.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td>4. Total Sewa Pokok Minimum (MGR) yang Telah Dibayarkan:</td>
                                    <td style="text-align: right;">Rp <span t-field="doc.total_base_rent_paid" t-options="{'widget': 'monetary', 'display_currency': doc.tenancy_id.currency_id}"/></td>
                                </tr>
                                <tr style="background-color: #EAF9EE; font-weight: bold; font-size: 14px;">
                                    <td style="color: #1F3964;">5. KEKURANGAN TAGIHAN OMZET (TRUE-UP AMOUNT):</td>
                                    <td style="text-align: right; color: #1F3964;">Rp <span t-field="doc.trueup_difference" t-options="{'widget': 'monetary', 'display_currency': doc.tenancy_id.currency_id}"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table style="width: 100%; margin-top: 40px; text-align: center;">
                            <tr>
                                <td style="width: 50%;">
                                    <b>Penyewa (Tenant)</b><br/><br/><br/><br/>
                                    ( _______________________ )<br/>
                                    <span t-field="doc.tenant_id.name"/>
                                </td>
                                <td style="width: 50%;">
                                    <b>Pengelola Mall / Commercial Division</b><br/><br/><br/><br/>
                                    ( _______________________ )<br/>
                                    <span t-field="doc.company_id.name"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
