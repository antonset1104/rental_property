<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_tenancy_amendment" model="ir.actions.report">
        <field name="name">Surat Perjanjian Adendum Sewa</field>
        <field name="model">property.tenancy.amendment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rental_management_rent_escalation.report_tenancy_amendment_document</field>
        <field name="report_file">rental_management_rent_escalation.report_tenancy_amendment_document</field>
        <field name="print_report_name">'Adendum_%s' % object.name.replace('/', '_')</field>
    </record>

    <template id="report_tenancy_amendment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 13px; color: #2C3E50; line-height: 1.6;">
                        <div class="text-center" style="border-bottom: 2px solid #1F3964; padding-bottom: 8px; margin-bottom: 16px;">
                            <h2 style="color: #1F3964; font-weight: bold; margin: 0; text-transform: uppercase;">
                                SURAT PERJANJIAN PERUBAHAN SEWA (ADENDUM)
                            </h2>
                            <p style="margin: 4px 0 0 0; font-size: 13px; color: #555;">
                                <b>Nomor Adendum:</b> <span t-field="doc.name"/> | <b>Tanggal:</b> <span t-field="doc.amendment_date" t-options="{'widget': 'date'}"/>
                            </p>
                        </div>
                        <p>
                            Pada hari ini, tanggal <b><span t-field="doc.amendment_date" t-options="{'widget': 'date'}"/></b>, telah disepakati perubahan/adendum atas Perjanjian Sewa Menyewa Unit Properti sebagai berikut:
                        </p>
                        <table class="table table-bordered table-sm" style="margin-bottom: 16px; border-color: #B0C4DE;">
                            <tbody>
                                <tr style="background-color: #F4F7FB;">
                                    <td colspan="2" style="font-weight: bold; color: #1F3964;">DATA PERJANJIAN INDUK &amp; PENYEWA</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold; width: 30%;">Nomor Kontrak Induk:</td>
                                    <td style="width: 70%;"><span t-field="doc.tenancy_id.name"/> (<span t-field="doc.tenancy_id.tenancy_seq"/>)</td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Penyewa (Tenant):</td>
                                    <td><span t-field="doc.tenant_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Unit Properti &amp; Gedung:</td>
                                    <td><span t-field="doc.property_id.name"/> - <span t-field="doc.company_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight: bold;">Jenis Perubahan:</td>
                                    <td><b><span t-field="doc.amendment_type"/></b></td>
                                </tr>
                            </tbody>
                        </table>
                        <h5 style="color: #1F3964; font-weight: bold;">KLAUSUL PERUBAHAN &amp; PENETAPAN BARU:</h5>
                        <table class="table table-bordered table-sm" style="margin-bottom: 16px; border-color: #B0C4DE;">
                            <thead style="background-color: #1F3964; color: white;">
                                <tr>
                                    <th style="width: 50%;">Klausul / Ketentuan Lama</th>
                                    <th style="width: 50%;">Klausul / Ketentuan Baru</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        Tarif Sewa: Rp <span t-field="doc.previous_rent" t-options="{'widget': 'monetary', 'display_currency': doc.tenancy_id.currency_id}"/><br/>
                                        Masa Berlaku s.d.: <span t-field="doc.previous_end_date"/>
                                    </td>
                                    <td style="background-color: #EAF9EE;">
                                        <b>Tarif Sewa Baru: Rp <span t-field="doc.new_rent" t-options="{'widget': 'monetary', 'display_currency': doc.tenancy_id.currency_id}"/></b><br/>
                                        <b>Masa Berlaku Baru s.d.: <span t-field="doc.new_end_date"/></b>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div style="background-color: #F9FAFC; border: 1px solid #D3D3D3; padding: 10px; margin-bottom: 20px;">
                            <b>Keterangan &amp; Penjelasan:</b>
                            <p style="white-space: pre-wrap; margin: 4px 0 0 0;"><span t-field="doc.description"/></p>
                        </div>
                        <table style="width: 100%; margin-top: 40px; text-align: center;">
                            <tr>
                                <td style="width: 50%;">
                                    <b>Pihak Pengelola (Building Management)</b><br/><br/><br/><br/>
                                    ( _______________________ )<br/>
                                    <span t-field="doc.company_id.name"/>
                                </td>
                                <td style="width: 50%;">
                                    <b>Pihak Penyewa (Tenant)</b><br/><br/><br/><br/>
                                    ( _______________________ )<br/>
                                    <span t-field="doc.tenant_id.name"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
