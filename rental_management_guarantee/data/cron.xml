<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_guarantee_expiry" model="ir.cron">
            <field name="name">Tenant Guarantee: Check Expiry &amp; Remind</field>
            <field name="model_id" ref="model_property_tenant_guarantee"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_guarantee_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 15:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
