<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_owner_remittance_list" model="ir.ui.view">
        <field name="name">property.owner.remittance.list</field>
        <field name="model">property.owner.remittance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_id"/>
                <field name="date"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_property_owner_remittance_form" model="ir.ui.view">
        <field name="name">property.owner.remittance.form</field>
        <field name="model">property.owner.remittance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute_owners" type="object"
                            string="Compute from Owners" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Post"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state != 'cancel'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="available_for_remittance"/>
                            <field name="total_amount"/>
                            <field name="move_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="owner_id"/>
                            <field name="percentage"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_property_owner_remittance" model="ir.actions.act_window">
        <field name="name">Owner Remittances</field>
        <field name="res_model">property.owner.remittance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
