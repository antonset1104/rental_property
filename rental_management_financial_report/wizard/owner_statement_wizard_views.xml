<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_owner_statement_wizard_form" model="ir.ui.view">
        <field name="name">property.owner.statement.wizard.form</field>
        <field name="model">property.owner.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Owners Statement">
                <group>
                    <group>
                        <field name="property_id"/>
                        <field name="fy_start_month"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print Owners Statement"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_owner_statement_wizard" model="ir.actions.act_window">
        <field name="name">Owners Statement</field>
        <field name="res_model">property.owner.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
