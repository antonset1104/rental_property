<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_details_form_view_documents" model="ir.ui.view">
        <field name="name">property.details.form.documents</field>
        <field name="model">property.details</field>
        <field name="inherit_id" ref="rental_management.property_details_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Documents (App)" name="documents_app">
                    <group>
                        <field name="documents_folder_id"/>
                        <field name="documents_count"/>
                    </group>
                    <button name="action_open_documents" type="object"
                            string="Open / Sync Documents" class="btn-primary"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
