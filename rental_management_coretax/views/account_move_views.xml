<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_coretax" model="ir.ui.view">
        <field name="name">account.move.form.coretax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CORETAX e-Faktur" name="coretax_efaktur"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group>
                            <field name="coretax_trx_code"/>
                            <field name="coretax_invoice_opt"/>
                            <field name="coretax_add_info"/>
                            <field name="coretax_facility_stamp"/>
                            <field name="coretax_ref_desc"/>
                        </group>
                        <group>
                            <field name="coretax_seller_idtku"/>
                            <field name="coretax_buyer_idtku"/>
                            <field name="coretax_custom_doc"/>
                            <field name="coretax_custom_doc_my"/>
                            <field name="coretax_exported" readonly="1"/>
                            <field name="coretax_export_date" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
