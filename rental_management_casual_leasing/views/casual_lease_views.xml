<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_casual_lease_list" model="ir.ui.view">
        <field name="name">property.casual.lease.list</field>
        <field name="model">property.casual.lease</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'"
                  decoration-success="state == 'active'">
                <field name="name"/>
                <field name="property_id"/>
                <field name="space_name"/>
                <field name="partner_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="duration_days"/>
                <field name="amount_total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'confirm'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_property_casual_lease_form" model="ir.ui.view">
        <field name="name">property.casual.lease.form</field>
        <field name="model">property.casual.lease</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object"
                            string="Create Invoice" class="btn-primary"
                            invisible="state in ('draft', 'cancel') or invoice_id"/>
                    <button name="action_activate" type="object" string="Set Active"
                            invisible="state != 'confirm'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id" readonly="state not in ('draft', 'confirm')"/>
                            <field name="space_name"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="duration_days"/>
                            <field name="rate_type"/>
                            <field name="rate"/>
                            <field name="quantity"/>
                            <field name="amount_total"/>
                            <field name="deposit"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_property_casual_lease" model="ir.actions.act_window">
        <field name="name">Casual Leases</field>
        <field name="res_model">property.casual.lease</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
