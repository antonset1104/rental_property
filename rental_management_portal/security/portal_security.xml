<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="tenancy_details_portal_rule" model="ir.rule">
            <field name="name">Tenant Portal: own contracts only</field>
            <field name="model_id" ref="rental_management.model_tenancy_details"/>
            <field name="domain_force">
                [('tenancy_id', 'child_of', user.partner_id.commercial_partner_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
