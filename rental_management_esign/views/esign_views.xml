<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_signature_request_list" model="ir.ui.view">
        <field name="name">property.signature.request.list</field>
        <field name="model">property.signature.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'signed'" decoration-danger="state == 'declined'">
                <field name="name"/><field name="tenancy_id"/><field name="signer_id"/>
                <field name="sent_date"/><field name="signed_date"/>
                <field name="state" widget="badge" decoration-success="state == 'signed'"/>
            </list>
        </field>
    </record>
    <record id="view_signature_request_form" model="ir.ui.view">
        <field name="name">property.signature.request.form</field>
        <field name="model">property.signature.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Mark Sent" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_signed" type="object" string="Mark Signed" class="btn-primary" invisible="state not in ('sent',)"/>
                    <button name="action_decline" type="object" string="Decline" invisible="state not in ('sent',)"/>
                    <button name="action_draft" type="object" string="Set to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="tenancy_id"/><field name="property_id"/>
                            <field name="signer_id"/><field name="note"/>
                        </group>
                        <group>
                            <field name="document" filename="document_filename"/>
                            <field name="document_filename" invisible="1"/>
                            <field name="sent_date"/><field name="signed_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_signature_request" model="ir.actions.act_window">
        <field name="name">Signature Requests</field>
        <field name="res_model">property.signature.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_signature_request" name="Signature Requests"
              parent="rental_management.main_menu_rental_management"
              action="action_signature_request" sequence="74"/>
</odoo>
