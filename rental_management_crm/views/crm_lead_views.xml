<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_leasing" model="ir.ui.view">
        <field name="name">crm.lead.form.leasing</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tenancies" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="tenancy_count == 0">
                    <field name="tenancy_count" widget="statinfo"
                           string="Lease Contracts"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='expected_revenue']" position="after">
                <field name="expected_rent"/>
                <field name="lease_months"/>
                <field name="expected_move_in"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_lease_contract" type="object"
                        string="Create Lease Contract" class="btn-secondary"
                        invisible="not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
