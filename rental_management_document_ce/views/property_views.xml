<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="property_details_form_view_documents_ce" model="ir.ui.view">
        <field name="name">property.details.form.documents.ce</field>
        <field name="model">property.details</field>
        <field name="inherit_id" ref="rental_management.property_details_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Files" name="files_ce">
                    <field name="attachment_count" invisible="1"/>
                    <button name="action_view_attachments" type="object"
                            class="btn-primary" icon="fa-paperclip"
                            string="Open Property Files"/>
                    <p class="text-muted mt-2">
                        Centralised attachments for this property (Community —
                        uses ir.attachment, no Enterprise Documents app needed).
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
