<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_list" model="ir.ui.view">
        <field name="name">property.insurance.policy.list</field>
        <field name="model">property.insurance.policy</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'" decoration-muted="state == 'cancelled'">
                <field name="name"/><field name="property_id"/><field name="coverage_type"/>
                <field name="insurer"/><field name="policy_number"/><field name="sum_insured"/>
                <field name="expiry_date"/><field name="days_to_expiry"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'expired'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_insurance_form" model="ir.ui.view">
        <field name="name">property.insurance.policy.form</field>
        <field name="model">property.insurance.policy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled',)"/>
                    <button name="action_draft" type="object" string="Set to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="property_id"/><field name="coverage_type"/>
                            <field name="insurer"/><field name="policy_number"/>
                        </group>
                        <group>
                            <field name="sum_insured"/><field name="premium"/>
                            <field name="start_date"/><field name="expiry_date"/>
                            <field name="reminder_days"/><field name="days_to_expiry"/>
                            <field name="responsible_id"/><field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_insurance" model="ir.actions.act_window">
        <field name="name">Insurance Policies</field>
        <field name="res_model">property.insurance.policy</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_insurance" name="Insurance Policies"
              parent="rental_management.main_menu_rental_management"
              action="action_insurance" sequence="87"/>
</odoo>
