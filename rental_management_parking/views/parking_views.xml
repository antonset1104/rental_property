<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_parking_bay_list" model="ir.ui.view">
        <field name="name">property.parking.bay.list</field>
        <field name="model">property.parking.bay</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-success="status == 'available'" decoration-warning="status == 'allocated'">
                <field name="code"/><field name="property_id"/><field name="zone"/>
                <field name="bay_type"/><field name="partner_id"/><field name="tenancy_id"/>
                <field name="monthly_rate"/>
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-warning="status == 'allocated'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_parking_bay_form" model="ir.ui.view">
        <field name="name">property.parking.bay.form</field>
        <field name="model">property.parking.bay</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_allocate" type="object" string="Allocate" class="btn-primary" invisible="status == 'allocated'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" invisible="status != 'allocated'"/>
                    <button name="action_release" type="object" string="Release" invisible="status != 'allocated'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/><field name="property_id"/><field name="zone"/><field name="bay_type"/>
                        </group>
                        <group>
                            <field name="partner_id"/><field name="tenancy_id"/>
                            <field name="monthly_rate"/><field name="product_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_parking_bay" model="ir.actions.act_window">
        <field name="name">Parking Bays</field>
        <field name="res_model">property.parking.bay</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_parking_bay" name="Parking"
              parent="rental_management.main_menu_rental_management"
              action="action_parking_bay" sequence="77"/>
</odoo>
