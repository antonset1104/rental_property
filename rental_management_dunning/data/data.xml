<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_late_fee" model="product.product">
            <field name="name">Late Payment Fee</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>
        <record id="mail_template_dunning" model="mail.template">
            <field name="name">Rental: Payment Reminder</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Payment Reminder - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear <t t-out="object.partner_id.name or ''"/>,</p>
                    <p>This is a reminder that invoice <strong t-out="object.name or ''"/>
                       with amount due <strong t-out="object.amount_residual or 0.0"/>
                       is overdue (due date <t t-out="object.invoice_date_due or ''"/>).</p>
                    <p>Please arrange payment at your earliest convenience.</p>
                    <p>Regards,<br/><t t-out="object.company_id.name or ''"/></p>
                </div>
            </field>
        </record>
        <!-- Default dunning ladder -->
        <record id="dunning_level_1" model="property.dunning.level">
            <field name="name">Reminder 1 (7 days)</field>
            <field name="level">1</field>
            <field name="days_overdue">7</field>
            <field name="mail_template_id" ref="mail_template_dunning"/>
        </record>
        <record id="dunning_level_2" model="property.dunning.level">
            <field name="name">Reminder 2 (30 days)</field>
            <field name="level">2</field>
            <field name="days_overdue">30</field>
            <field name="mail_template_id" ref="mail_template_dunning"/>
            <field name="late_fee_percent">2.0</field>
        </record>
        <record id="dunning_level_3" model="property.dunning.level">
            <field name="name">Final Notice (60 days)</field>
            <field name="level">3</field>
            <field name="days_overdue">60</field>
            <field name="mail_template_id" ref="mail_template_dunning"/>
            <field name="late_fee_percent">5.0</field>
        </record>
    </data>
</odoo>
