<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_property" model="ir.ui.view">
        <field name="name">purchase.order.form.property</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Property" name="property">
                    <group>
                        <field name="property_id"/>
                        <field name="tenancy_id"/>
                        <field name="maintenance_request_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_property_purchase_order" model="ir.actions.act_window">
        <field name="name">Property Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id', '!=', False)]</field>
        <field name="context">{'search_default_property_id': 1}</field>
    </record>
</odoo>
