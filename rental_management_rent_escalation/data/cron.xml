<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_rent_escalation" model="ir.cron">
            <field name="name">Rental: Apply Due Rent Escalations</field>
            <field name="model_id" ref="rental_management.model_tenancy_details"/>
            <field name="state">code</field>
            <field name="code">model._cron_apply_rent_escalation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field><field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 15:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
