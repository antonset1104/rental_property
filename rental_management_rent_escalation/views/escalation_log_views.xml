<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_escalation_log_list" model="ir.ui.view">
        <field name="name">property.rent.escalation.log.list</field>
        <field name="model">property.rent.escalation.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="tenancy_id"/>
                <field name="property_id"/>
                <field name="old_rent"/>
                <field name="new_rent"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_escalation_log" model="ir.actions.act_window">
        <field name="name">Rent Escalation Log</field>
        <field name="res_model">property.rent.escalation.log</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_escalation_log" name="Rent Escalation Log"
              parent="rental_management.main_menu_rental_management"
              action="action_escalation_log" sequence="80"/>
</odoo>
